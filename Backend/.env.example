# Postgres connection string used by Prisma (migrations + runtime)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pocketly_dev"

# Port the Express server listens on
PORT=3000

# bcrypt cost factor for password hashing
BCRYPT_SALT_ROUNDS=12

# Signing key for auth tokens. Must be a long random string in production.
JWT_SECRET="replace-with-a-long-random-string"

# How long an issued token stays valid
JWT_EXPIRES_IN=7d
