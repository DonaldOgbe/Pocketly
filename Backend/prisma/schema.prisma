// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  bookmark      Bookmark[]
  revokedTokens RevokedToken[]
  collections   Collection[]
  tags          Tag[]
}

model Bookmark {
  id             String      @id @default(uuid())
  userId         String
  url            String
  domain         String
  title          String?
  metadataStatus String
  thumbnail      String?
  favicon        String?
  description    String?
  isFavorite     Boolean   @default(false)
  isRead         Boolean   @default(false)
  savedAt        DateTime  @default(now())
  readAt         DateTime?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  collections     Collection[]
  tags            Tag[]

  // GET /bookmarks filters on userId and orders by savedAt.
  @@index([userId, savedAt])
}

// Revoked token ids. A row only has to outlive the token it revokes.
model RevokedToken {
  jti       String   @id
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Collection {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]

  @@index([userId])
}


model Tag {
  id        String     @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id])
  bookmarks Bookmark[] 
  @@unique([userId, name]) // not duplicate tags
}